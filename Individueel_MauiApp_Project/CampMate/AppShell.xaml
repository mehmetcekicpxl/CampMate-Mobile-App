<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampMate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampMate.Views"
    
    Title="CampMate"
    Shell.FlyoutBehavior="Disabled">
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.FlyoutItemIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="RegisterPage"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Shell.FlyoutItemIsVisible="False"
        Shell.NavBarIsVisible="True" />

    <FlyoutItem x:Name="HomeFlyout" Title="Home" Icon="home.jpg" Route="HomeRoute" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="Home" />
    </FlyoutItem>

    <FlyoutItem x:Name="ProfileFlyout" Title="Profile" Icon="profile.jpg" Route="ProfileRoute" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="Profile" />
    </FlyoutItem>

    <FlyoutItem x:Name="SettingsFlyout" Title="Settings" Icon="settings.jpg" Route="SettingsRoute" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="Settings" />
    </FlyoutItem>

</Shell>
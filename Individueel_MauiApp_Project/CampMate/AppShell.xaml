<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampMate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampMate.Views"
    
    Title="CampMate"
    
    
    
    >
    <!--<ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}"
        
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="RegisterPage"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        
        Shell.NavBarIsVisible="True" />-->

    <TabBar Route="MainTabs">
        <Tab Title="Home" Route="HomePage"  >
            <Tab.Icon>
                <FontImageSource FontFamily="MDI"
                         Glyph="&#xF02DC;"
                    Color="Black"
                         Size="28"/>
            </Tab.Icon>
            <ShellContent
            
            ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <Tab Title="Profile"  Route="ProfilePage">
            <Tab.Icon>
                <FontImageSource FontFamily="MDI" 
              Glyph="&#xF0009;"
         Color="Black"
              Size="28"/>
            </Tab.Icon>
            <ShellContent  ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

        <Tab Title="Settings"  Route="SettingsPage">
            <Tab.Icon>
                <FontImageSource FontFamily="MDI" 
                 Glyph="&#xF08D6;"
            Color="Black"
                 Size="28"/>    
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>


</Shell>
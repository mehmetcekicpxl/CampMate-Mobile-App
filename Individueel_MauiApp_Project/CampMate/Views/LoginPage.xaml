<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.LoginPage"
             Title="Login">

    <VerticalStackLayout Padding="20">
        <Label Text="LOGIN" FontSize="28" HorizontalOptions="Center"/>

        <Entry Placeholder="Email" 
               Text="{Binding UserEmail, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
               Keyboard="Email"/>

        <Entry Placeholder="Password" 
               IsPassword="True" 
               Text="{Binding UserPassword, Mode=TwoWay, UpdateSourceEventName=TextChanged}"/>

        <Button Text="Login" Clicked="OnLoginClicked"/>
        <Button Text="Register" Clicked="OnRegisterClicked" BackgroundColor="Green"/>
        <Border x:Name="LogoutMessage" 
        IsVisible="False" 
        BackgroundColor="{StaticResource Error}" 
        StrokeShape="RoundRectangle 8" 
        Padding="15" 
        Margin="0, 40, 0, 0"
        HorizontalOptions="FillAndExpand">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Image Source="info.png" WidthRequest="20" HeightRequest="20" />
                <Label Text="Je bent uitgelogd" 
               TextColor="{StaticResource White}" 
               VerticalOptions="Center" 
               FontSize="16" />
            </StackLayout>
        </Border>
    </VerticalStackLayout>
    
</ContentPage>
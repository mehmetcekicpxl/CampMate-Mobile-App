<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CampMate.Behaviors"
             x:Class="CampMate.Views.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False">
    <Grid>

        <Image Source="bg.jpg" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill"/>

        

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

                <Image Source="campmatelogo2.png" Opacity="0.8" HeightRequest="170"  Margin="0,0,30,-10"/>

                <Label Text="Welkom Terug!" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#80FFFFFF" Padding="5">
                    <Entry Placeholder="Email" 
                           Text="{Binding UserEmail, Mode=TwoWay}" 
                           TextColor="Black" 
                           PlaceholderColor="#333333"
                           Keyboard="Email"  
                           IsSpellCheckEnabled="False" 
                           IsTextPredictionEnabled="False">
                        <Entry.Behaviors>
                            <behaviors:EmailValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>
                </Border>

                <Label FontSize="11" Margin="5,-5,0,15" LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Let op: " TextColor="#FFCC00" FontAttributes="Bold"/>
                            <Span Text="Rood" TextColor="#FF5555" FontAttributes="Bold"/>
                            <Span Text=" betekent ongeldig formaat." TextColor="#DDDDDD"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#80FFFFFF" Padding="5">
                    <Entry Placeholder="Wachtwoord" 
                           IsPassword="True" 
                           Text="{Binding UserPassword, Mode=TwoWay}" 
                           TextColor="Black" 
                           PlaceholderColor="#333333"/>
                </Border>

                <Button Text="Login" 
                        Command="{Binding LoginCommand}" 
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"/>

                <Button Text="Nog geen account? Registreer hier" 
                        Command="{Binding RegisterCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="White"
                        FontSize="14"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
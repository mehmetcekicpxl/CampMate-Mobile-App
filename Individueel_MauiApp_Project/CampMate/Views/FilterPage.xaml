<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.FilterPage"
             Title="Filters">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Select Location" FontAttributes="Bold"/>

            <Picker  x:Name="LocationPicker">
                <Picker.Items>
                    
                    
                    
                </Picker.Items>
            </Picker>

            <Label Text="Facilities" FontAttributes="Bold"/>

            <VerticalStackLayout x:Name="FacilitiesCheckBoxGroup" Spacing="10">
                <HorizontalStackLayout>
                    <CheckBox x:Name="ZwembadCheckBox"/>
                    <Label Text="Zwembad"/>
                </HorizontalStackLayout>

               
                <HorizontalStackLayout>
                    <CheckBox x:Name="FietsverhuurCheckBox"/>
                    <Label Text="Fietsverhuur"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <CheckBox x:Name="ElektriciteitCheckBox"/>
                    <Label Text="Elektriciteit"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <CheckBox x:Name="CafeCheckBox"/>
                    <Label Text="Cafe"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Text="Apply Filters" Clicked="ApplyFilters_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

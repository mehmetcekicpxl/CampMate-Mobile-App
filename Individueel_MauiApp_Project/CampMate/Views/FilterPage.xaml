<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.FilterPage"
             Title="Filters">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Select Location" FontAttributes="Bold"/>

            <Picker ItemsSource="{Binding Locations}"
                    SelectedItem="{Binding SelectedLocation}"
                    Title="Kies een locatie">
            </Picker>

            <Label Text="Facilities" FontAttributes="Bold"/>

            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasZwembad}"/>
                    <Label Text="Zwembad" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasFietsverhuur}"/>
                    <Label Text="Fietsverhuur" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasElektriciteit}"/>
                    <Label Text="Elektriciteit" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasCafe}"/>
                    <Label Text="Cafe" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Text="Apply Filters" 
                    Command="{Binding ApplyFiltersCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             x:Class="CampMate.Views.SettingsPage"

             Title="Instellingen"

             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkGreen}}">



    <ScrollView>

        <VerticalStackLayout Spacing="20" Padding="20">



            <Label Text="Pas je voorkeuren aan" 

                   FontSize="16" 

                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource White}}" />



            <Border StrokeShape="RoundRectangle 10" 

                    Padding="15" 

                    StrokeThickness="2" 

                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource MediumDarkGreen}}">

                <VerticalStackLayout Spacing="15">



                    <Label Text="Weergave" 

                           FontSize="18" 

                           FontAttributes="Bold" 

                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />



                    <Grid ColumnDefinitions="*, Auto">

                        <StackLayout Orientation="Horizontal" Spacing="10">

                            <Label Text="&#xf050E;"  FontFamily="MDI"

                                   FontSize="20"

                                   VerticalOptions="Center"

                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />



                            <Label Text="Donkere modus" 

                                   VerticalOptions="Center" 

                                   FontSize="16" 

                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                        </StackLayout>

                        <Switch x:Name="DarkModeSwitch" 

                                Toggled="OnDarkModeToggled" 

                                Grid.Column="1" />

                    </Grid>



                    

                </VerticalStackLayout>

            </Border>



            <Border StrokeShape="RoundRectangle 10" 

                    Padding="15" 

                    StrokeThickness="2" 

                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource MediumDarkGreen}}">

                <VerticalStackLayout Spacing="15">



                    <Label Text="Beveiliging" 

                           FontSize="18" 

                           FontAttributes="Bold"

                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>



                    <Button Text="Wachtwoord wijzigen" 

                            Style="{StaticResource SecurityButtonStyle}"

                            Clicked="ChangePassword_Clicked">

                        <Button.ImageSource>

                            <FontImageSource FontFamily="MDI" 

                               Glyph="&#xf0773;"  Color="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource White}}"

                               Size="20"/>

                        </Button.ImageSource>

                    </Button>

                </VerticalStackLayout>

            </Border>



            <Border x:Name="PasswordChangeForm" 

                    IsVisible="False" 

                    StrokeShape="RoundRectangle 10" 

                    Padding="15" 

                    StrokeThickness="2" 

                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource MediumDarkGreen}}">

                <VerticalStackLayout Spacing="10">

                    <Entry x:Name="CurrentPasswordEntry" Placeholder="Huidig wachtwoord" IsPassword="True" Style="{StaticResource DarkEntryStyle}" />

                    <Entry x:Name="NewPasswordEntry" Placeholder="Nieuw wachtwoord" IsPassword="True" Style="{StaticResource DarkEntryStyle}" />

                    <Entry x:Name="ConfirmNewPasswordEntry" Placeholder="Bevestig nieuw wachtwoord" IsPassword="True" Style="{StaticResource DarkEntryStyle}" />



                    <Grid ColumnDefinitions="*,*" Padding="0, 10, 0, 0">

                        <Button Text="Opslaan" Grid.Column="0" Style="{StaticResource OpslaanButtonStyle}" Margin="0, 0, 5, 0" Clicked="SavePassword_Clicked" />

                        <Button Text="Annuleren" Grid.Column="1" Style="{StaticResource AnnulerenButtonStyle}" Margin="5, 0, 0, 0" Clicked="CancelPasswordChange_Clicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>



            <Border StrokeShape="RoundRectangle 10" 

                    Padding="15" 

                    StrokeThickness="2" 

                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource MediumDarkGreen}}">

                <VerticalStackLayout Spacing="15">



                    <Label Text="Over CampMate" 

                           FontSize="18" 

                           FontAttributes="Bold"

                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>



                    <StackLayout Orientation="Horizontal" Spacing="10">

                        <Label Text="&#xf02fd;"  FontFamily="MDI"

                               FontSize="20"

                               VerticalOptions="Center"

                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />



                        <Label Text="Versie" 

                               VerticalOptions="Center" 

                               FontSize="16" 

                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                        <Label Text="1.0.0" 

                               VerticalOptions="Center" 

                               FontSize="16" 

                               FontAttributes="Bold"

                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>

                    </StackLayout>



                    <StackLayout Spacing="5">

                        <Label Text="Over" 

                               FontSize="16" 

                               FontAttributes="Bold"

                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                        <Label Text="CampMate helpt kampeerders om de perfecte camping te vinden voor hun volgende avontuur." 

                               FontSize="14" 

                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>

                    </StackLayout>

                </VerticalStackLayout>

            </Border>



            <Button Text="Uitloggen" 

                    BackgroundColor="{StaticResource Error}" 

                    TextColor="{StaticResource White}"

                    CornerRadius="8"

                    HeightRequest="50"

                    Margin="0, 10, 0, 20"

                    Clicked="LogoutButton_Clicked" >

                <Button.ImageSource>

                    <FontImageSource FontFamily="MDI" 

                   Glyph="&#xf0343;"  Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"

                   Size="20"/>

                </Button.ImageSource>

            </Button>



        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.AddCampPage"
             Title="Camping Toevoegen">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#1E2A28" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Basisinformatie" TextColor="White" FontAttributes="Bold" FontSize="18"/>

                    <Label Text="Naam camping *" TextColor="White"/>
                    <Entry Placeholder="Bos end Berg Camping" Text="{Binding Name}" TextColor="White"/>

                    <Label Text="Stad/Regio *" TextColor="White"/>
                    <Entry Placeholder="Veluwe" Text="{Binding Location}" TextColor="White"/>

                    <Label Text="Facilities" FontAttributes="Bold" TextColor="White"/>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding HasZwembad}"/>
                            <Label Text="Zwembad" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding HasFietsverhuur}"/>
                            <Label Text="Fietsverhuur" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding HasElektriciteit}"/>
                            <Label Text="Elektriciteit" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding HasCafe}"/>
                            <Label Text="Cafe" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#1E2A28" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Website Link (Optioneel)" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                    <Entry Placeholder="www.voorbeeld-kamp.com" 
               Text="{Binding WebsiteUrl}" 
               TextColor="White"
               Keyboard="Url"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#1E2A28" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Foto" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                    <Button Text="Select Image" Command="{Binding PickImageCommand}"/>
                    <Image Source="{Binding SelectedImageSource}" HeightRequest="200" Aspect="AspectFill"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#1E2A28" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Prijs van één nacht" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                    <Label Text="Prijs per nacht (€) *" TextColor="White"/>
                    <Entry Text="{Binding PriceText}" Keyboard="Numeric" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Camping Toevoegen"
                    Style="{StaticResource OpslaanButtonStyle}"
                    Command="{Binding SaveCampCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
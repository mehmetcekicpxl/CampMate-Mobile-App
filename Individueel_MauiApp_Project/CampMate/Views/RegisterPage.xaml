<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.RegisterPage"
             Title="Register">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Label Text="Maak een nieuw account aan" 
           FontSize="28" 
           HorizontalOptions="Center" 
           TextColor="{StaticResource Primary}"
           Margin="0,0,0,20"/>

        <Entry x:Name="NameEntry" 
           Placeholder="Naam"
           IsSpellCheckEnabled="False"
           IsTextPredictionEnabled="False"/>

        <Entry x:Name="EmailEntry" 
           Placeholder="E-mail Adress" 
           Keyboard="Email"
           IsSpellCheckEnabled="False"
           IsTextPredictionEnabled="False"/>

        <Entry x:Name="PhoneEntry" 
           Placeholder="Telefoonnummer" 
           Keyboard="Telephone"
           IsSpellCheckEnabled="False"
           IsTextPredictionEnabled="False"/>

        <Entry x:Name="LocationEntry" 
           Placeholder="Woonplaats"
           IsSpellCheckEnabled="False"
           IsTextPredictionEnabled="False"/>

        <Entry x:Name="PasswordEntry" 
           Placeholder="Wachtwoord" 
           IsPassword="True"/>

        <Entry x:Name="ConfirmPasswordEntry" 
           Placeholder="Wachtwoord herhalen" 
           IsPassword="True"/>

        <Button Text="Registeren" 
            Clicked="OnRegisterCompleted" 
            Margin="0, 20, 0, 0"
            BackgroundColor="{StaticResource Primary}"/>

        <Button Text="Ga Naar Login" 
            Clicked="OnBackToLoginClicked" 
            Style="{StaticResource TextButton}" />

    </VerticalStackLayout>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.RegisterPage"
             Title="Register">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Label Text="Maak een nieuw account aan" 
               FontSize="Title" 
               HorizontalOptions="Center" 
               TextColor="{StaticResource Primary}"/>

        <Entry Placeholder="E-mail Adress" 
               Keyboard="Email" 
               Margin="0, 10, 0, 0"/>

        <Entry Placeholder="wachtwoord " 
               IsPassword="True"/>

        <Entry Placeholder="wachtwoord herhalen" 
               IsPassword="True"/>

        <Button Text="Registeren" 
                Clicked="OnRegisterCompleted" 
                Margin="0, 20, 0, 0"/>

        <Button Text="Ga Naar Login" 
                Clicked="OnBackToLoginClicked" 
                Style="{StaticResource TextButton}" 
                />

    </VerticalStackLayout>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CampMate.Behaviors"
             x:Class="CampMate.Views.RegisterPage"
             Style="{StaticResource InternalPageStyle}"
             Title="Register"
             Shell.FlyoutBehavior="Disabled">
    <Grid>
       

        <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="#99000000"
                Margin="20, 40, 20, 40"
                Padding="20"
                VerticalOptions="Center">

            <ScrollView>
                <VerticalStackLayout Spacing="15">

                    <Label Text="Maak een nieuw account aan"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White"
                           Margin="0,0,0,20"/>

                    <Entry Placeholder="Naam" Text="{Binding Name}" TextColor="White" PlaceholderColor="#CCCCCC"/>

                    <Entry Placeholder="E-mail Adress" Text="{Binding Email}" Keyboard="Email" TextColor="White" PlaceholderColor="#CCCCCC">
                        <Entry.Behaviors>
                            <behaviors:EmailValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label FontSize="11" Margin="5,-5,0,15" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Tip: " TextColor="#FFCC00" FontAttributes="Bold"/>
                                <Span Text="Als het rood is, klopt het formaat niet." TextColor="#CCCCCC"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Entry Placeholder="Telefoonnummer" Text="{Binding PhoneNumber}" Keyboard="Telephone" TextColor="White" PlaceholderColor="#CCCCCC"/>
                    <Entry Placeholder="Woonplaats" Text="{Binding Location}" TextColor="White" PlaceholderColor="#CCCCCC"/>

                    <Entry Placeholder="Wachtwoord" Text="{Binding Password}" IsPassword="True" TextColor="White" PlaceholderColor="#CCCCCC">
                        <Entry.Behaviors>
                            <behaviors:PasswordValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label FontSize="12" HorizontalOptions="Start" Margin="5,-5,0,15">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Sterkte: " TextColor="#CCCCCC"/>
                                <Span Text="Zwak" TextColor="#FF5555" FontAttributes="Bold"/>
                                <Span Text=", " TextColor="#CCCCCC"/>
                                <Span Text="Gemiddeld" TextColor="#FFCC00" FontAttributes="Bold"/>
                                <Span Text=", " TextColor="#CCCCCC"/>
                                <Span Text="Sterk" TextColor="#55FF55" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Entry Placeholder="Wachtwoord herhalen" Text="{Binding ConfirmPassword}" IsPassword="True" TextColor="White" PlaceholderColor="#CCCCCC">
                        <Entry.Behaviors>
                            <behaviors:PasswordValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Button Text="Registeren"
                            Command="{Binding RegisterCommand}"
                            Margin="0, 20, 0, 0"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50"/>

                    <Button Text="Ga Naar Login"
                            Command="{Binding GoToLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="14"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
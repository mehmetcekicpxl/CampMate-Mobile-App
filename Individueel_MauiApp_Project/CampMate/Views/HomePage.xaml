<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.HomePage"
             Title="CampMate Home">

  

    <ScrollView x:Name="MainScrollView">
        <VerticalStackLayout Padding="10" Spacing="10">

            <Label Text="HOME" 
                   FontSize="24" FontAttributes="Bold"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" Margin="0,10,0,20" />

            <Border Stroke="#2A9D8F" BackgroundColor="White" StrokeShape="RoundRectangle 20" HeightRequest="50" Padding="10,0">
                <Entry Placeholder="Search for a name or region..." 
                       TextColor="Black" 
                       PlaceholderColor="Gray"
                       TextChanged="SearchEntry_TextChanged"
                       VerticalOptions="Center"/>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HeightRequest="45">
                <Button Text="Filters" Grid.Column="0" 
                        BackgroundColor="#2A9D8F" TextColor="White" 
                        CornerRadius="20" Clicked="FilterButton_Clicked"
                        ImageSource="{FontImageSource FontFamily=MDI, Glyph='&#xF0232;', Color=White, Size=18}"/>

                <Button Text="Add New Camp" Grid.Column="1" 
                        BackgroundColor="#E76F51" TextColor="White" 
                        CornerRadius="20" Clicked="AddNewCampButton_Clicked"
                        ImageSource="{FontImageSource FontFamily=MDI, Glyph='&#xF0415;', Color=White, Size=18}"/>
            </Grid>

            <CollectionView x:Name="CampListView" 
                            Margin="0,10,0,0"
                            SelectionMode="Single"
                            SelectionChanged="OnCampSelected">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="0">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#F0F0F0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                            <Grid RowDefinitions="180, Auto, Auto" Padding="0">

                                <Grid Grid.Row="0">
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                                    <Border BackgroundColor="#CCFFFFFF" StrokeShape="RoundRectangle 20" 
                                            HorizontalOptions="End" VerticalOptions="Start" 
                                            Margin="10" Padding="5" HeightRequest="40" WidthRequest="40">

                                        <ImageButton Clicked="FavoriteButton_Clicked" CommandParameter="{Binding .}" BackgroundColor="Transparent">
                                            <ImageButton.Source>
                                                <FontImageSource FontFamily="MDI" 
                                                                 Glyph="{Binding IsFavorite, Converter={StaticResource BoolToHeartIconConverter}}" 
                                                                 Color="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}" 
                                                                 Size="24"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Padding="15,10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding Name}" Grid.Column="0" FontSize="18" FontAttributes="Bold" TextColor="Black" LineBreakMode="TailTruncation"/>

                                        <Label Text=" Meer Info >>>" 
                                               Grid.Column="1" 
                                               TextColor="#2A9D8F" 
                                               FontSize="14" 
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>   
                                    </Grid>

                                    <Label Text="{Binding Location}" FontSize="14" TextColor="Gray" Margin="0,2,0,0"/>
                                </VerticalStackLayout>

                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="15,0,15,15">
                                    <Label Text="{Binding Price, StringFormat='{0} € / Night'}" Grid.Column="0" TextColor="#2A9D8F" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>

                                    <Label Text="Tap for details ›" Grid.Column="1" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
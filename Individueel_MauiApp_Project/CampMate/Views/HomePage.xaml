<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampMate.Views.HomePage"
             
              >
    <ScrollView>


        <VerticalStackLayout>
            <Label 
                Text="HOME" FontSize="20"
                VerticalOptions="Center" 
                HorizontalOptions="Center"  Margin="0, 10 ,0 ,20" />

         

            <Border Stroke="Green" BackgroundColor="Beige" StrokeShape="RoundRectangle 10" Margin="0,0,0,10" HeightRequest="25">
                <Entry Placeholder="Search for a name or region" HeightRequest="10" TextColor="Black" TextChanged="SearchEntry_TextChanged"/>
            </Border>

            <Grid ColumnDefinitions="2*,1*" Padding="1" ColumnSpacing="1" HeightRequest="40">
                <Button Text="Filters" Grid.Column="0"  BackgroundColor="#2A9D8F" TextColor="White" CornerRadius="50" Clicked="FilterButton_Clicked"/>
                <Button Text="Add New Camp" Grid.Column="1" BackgroundColor="#E76F51" TextColor="White" CornerRadius="50" Clicked="AddNewCampButton_Clicked"/>
            </Grid>



            <CollectionView x:Name="CampListView" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Green" StrokeShape="RoundRectangle 10" Margin="5" BackgroundColor="Lavender">
                            <VerticalStackLayout Padding="1" Spacing="1" >

                                <Grid ColumnDefinitions="*,Auto, Auto">

                                    <Label Text="{Binding Name}" 
                                           Style="{StaticResource TitleTextStyle}" 
                                           TextColor="Black" 
                                           Grid.Column="0"/>
                                    <Label Text="Like" 
                                           TextColor="Black" 
                                           Grid.Column="1"/>
                                    

                                    <Grid Grid.Column="2" HeightRequest="25" WidthRequest="25">

                                        <ImageButton IsVisible="{Binding IsFavorite}"
                                             Clicked="FavoriteButton_Clicked"
                                             CommandParameter="{Binding .}">
                                            <ImageButton.Source>
                                                <FontImageSource FontFamily="MDI"
                                                     Glyph="&#xF02D1;" 
                                                     Color="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                     Size="25"/>
                                            </ImageButton.Source>
                                        </ImageButton>

                                        <ImageButton IsVisible="{Binding IsFavorite, Converter={StaticResource InverseBoolConverter}}"
                                             Clicked="FavoriteButton_Clicked"
                                             CommandParameter="{Binding .}">
                                                                    <ImageButton.Source>
                                                                        <FontImageSource FontFamily="MDI"
                                                         Glyph="&#xf02d5;" 
                                                         Color="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteColorConverter}}"
                                                         Size="25"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                       

                                    </Grid>

                                </Grid>

                                <Image Source="{Binding ImagePath}" HeightRequest="151" Aspect="AspectFill"/>


                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="20" TextColor="Black"/>


                                <Label Text="{Binding Location}" FontSize="16" TextColor="Black"  FontAttributes="Bold"/>


                                <Label Text="{Binding Stars, StringFormat='Rank ★ {0}'}" FontSize="16" TextColor="Green"/>


                                <Label Text="{Binding Facilities, StringFormat='Faciliteiten: {0}'}" FontSize="14" TextColor="Gray"/>


                                <Label Text="{Binding Price, StringFormat='Avond prijs: {0} €'}" FontSize="16" FontAttributes="Bold" TextColor="Green"/>



                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>




</ContentPage>